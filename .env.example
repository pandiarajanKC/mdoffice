# =============================================================
# MD Office Follow-up & Action Management System
# Environment configuration template.
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# =============================================================

# ---- Application ----
APP_ENV=development
# development | uat | production
PORT=5000
# The Werkzeug dev server binds 0.0.0.0:$PORT (see run.py) — reachable at
# this machine's real network address, not just 127.0.0.1.
SECRET_KEY=change-this-to-a-long-random-string
PRODUCT_NAME=MD Office
PRODUCT_SUBTITLE=Executive Follow-up & Action Management

# ---- SQL Server connection (shared) ----
DB_SERVER=172.17.50.2
DB_USERNAME=bc
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server

# Application's own database (Meeting/Task/Project/AppUser/etc.)
DB_APP_DATABASE=mdoffice

# Existing HR Employee Master (read-only, do not migrate/duplicate)
DB_EMPLOYEE_DATABASE=CUSTOMER_MASTER
DB_EMPLOYEE_TABLE=EmployeeList

# ---- Sessions / Security ----
SESSION_COOKIE_SECURE=false
# set true behind HTTPS in uat/production
REMEMBER_COOKIE_DURATION_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- File uploads ----
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=100

# ---- AI provider (OpenAI: Whisper for transcription, GPT for summarization) ----
# Get a key from https://platform.openai.com/api-keys
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
MAX_AUDIO_SIZE_MB=100

# ---- Google Calendar OAuth ----
# Create these in Google Cloud Console > APIs & Services > Credentials
# (OAuth client ID, type "Web application"). See README for full steps.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/calendar/oauth/callback

# ---- OAuth token encryption ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Redeploying against the SAME database this key already encrypted tokens
# with? Keep this value identical, or every existing Calendar/Gmail
# connection becomes undecryptable and has to be reconnected from scratch.
TOKEN_ENCRYPTION_KEY=

# ---- Background scheduler (reminders, escalations) ----
ENABLE_SCHEDULER=true

# ---- Logging ----
LOG_DIR=logs

# ---- Seed accounts (development only, used by scripts/seed_users.py) ----
SEED_MD_USERNAME=admin
SEED_MD_PASSWORD=
SEED_EA_USERNAME=admin1
SEED_EA_PASSWORD=
